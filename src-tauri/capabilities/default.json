{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main-window",
  "description": "Local Jerrivell PDF window and user-controlled file dialogs.",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "core:window:allow-set-title",
    "core:window:allow-destroy",
    "dialog:allow-open",
    "dialog:allow-save",
    "allow-open-compare-workspace",
    "allow-get-startup-files",
    "allow-drain-open-requests",
    "allow-register-pdf-integration",
    "allow-open-default-pdf-settings",
    "allow-preview-image-edit",
    "allow-get-backend-status",
    "allow-list-system-fonts",
    "allow-print-document",
    "allow-open-document",
    "allow-save-editable-project",
    "allow-load-editable-project",
    "allow-render-page",
    "allow-render-page-layers",
    "allow-search-document",
    "allow-search-pages",
    "allow-inspect-page-content",
    "allow-get-page-text",
    "allow-save-document",
    "allow-prepare-export",
    "allow-validate-document",
    "allow-save-prepared-export",
    "allow-discard-export",
    "allow-generate-pages",
    "allow-preview-line-edit",
    "allow-commit-line-preview",
    "allow-discard-line-preview",
    "allow-export-page",
    "allow-register-image",
    "allow-edit-image-asset",
    "allow-get-image-asset",
    "allow-rasterize-page-asset",
    "allow-extract-content-image",
    "allow-render-object-layers",
    "allow-import-image",
    "allow-preview-image",
    "allow-import-pdf-stamp",
    "allow-create-image-fragments",
    "allow-export-image",
    "allow-close-all-documents",
    "allow-retain-documents"
  ]
}
